# =============================================================================
# neuro.mplstyle: matplotlib style for neuroscience figures
#
#   plt.style.use("neuro")                     # paper figures (one column)
#   plt.style.use(["neuro", "neuro-talk"])     # slides
#   plt.style.use(["neuro", "neuro-dark"])     # dark slides
# =============================================================================

# ---- 02 · Axes, ticks, legend ---------------------------------------------
# No box: keep only the left and bottom spines
axes.spines.top: False
axes.spines.right: False

# Short ticks pointing outwards (away from the data)
xtick.direction: out
ytick.direction: out
xtick.major.size: 3
ytick.major.size: 3
xtick.minor.size: 1.5
ytick.minor.size: 1.5

# Panel titles on the left, as in most papers
axes.titlelocation: left

# Legends without a frame
legend.frameon: False

# ---- 03 · Plot elements -----------------------------------------------------
lines.linewidth: 1.0
lines.markersize: 3
lines.solid_capstyle: round

# Shaded areas (fill_between, bars, histograms) without outlines
patch.linewidth: 0.5
patch.force_edgecolor: False

# Error bars: no caps (cleaner); use errorbar(..., capsize=2) if you want them
errorbar.capsize: 0

# Heatmaps of (neurons x time) almost never have square pixels
image.aspect: auto

# Scatter points without outlines
scatter.edgecolors: none

# Shorter legend lines, closer to their labels
legend.handlelength: 1.5
legend.handletextpad: 0.5

# ---- 04 · Size, fonts, export ---------------------------------------------
# Default figure: one journal column (89 mm wide). Sizes are in inches.
figure.figsize: 3.5, 2.6
figure.dpi: 150              # only affects how big it looks in the notebook

# Fonts: first one found is used
font.family: sans-serif
font.sans-serif: Arial, Helvetica, Liberation Sans, DejaVu Sans
font.size: 7
axes.titlesize: 8
axes.labelsize: 7
xtick.labelsize: 6
ytick.labelsize: 6
legend.fontsize: 6
figure.titlesize: 8
mathtext.default: regular    # $\Delta F/F$ uses the same font as the rest

# Line widths (points), matched to 7 pt text
axes.linewidth: 0.6
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.minor.width: 0.4
ytick.minor.width: 0.4
grid.linewidth: 0.4

# Export
savefig.format: pdf          # fig.savefig("fig1") -> fig1.pdf
savefig.dpi: 300             # for raster formats and rasterized artists
savefig.bbox: standard       # keep exactly the size we asked for
pdf.fonttype: 42             # editable text in PDF
ps.fonttype: 42
svg.fonttype: none           # text stays text in SVG

# ---- 05 · Color -------------------------------------------------------------
# Okabe & Ito (2008) color-blind-safe palette (hex colors WITHOUT '#')
axes.prop_cycle: cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', 'E69F00', '56B4E9', 'F0E442', '000000'])

# Perceptually uniform default colormap (already matplotlib's default; written down to be explicit)
image.cmap: viridis

# ---- 06 · Layout --------------------------------------------------------------
# Arrange panels automatically so that labels, colorbars and legends don't overlap
figure.constrained_layout.use: True
figure.constrained_layout.h_pad: 0.03    # padding around each Axes, inches
figure.constrained_layout.w_pad: 0.03
