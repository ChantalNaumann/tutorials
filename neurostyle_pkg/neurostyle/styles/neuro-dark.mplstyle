# neuro-dark: for dark slide backgrounds. Combine with neuro-talk:
#   plt.style.use(["neuro", "neuro-talk", "neuro-dark"])
figure.facecolor: 111111
axes.facecolor: 111111
savefig.facecolor: 111111
text.color: EEEEEE
axes.labelcolor: EEEEEE
axes.edgecolor: EEEEEE
xtick.color: EEEEEE
ytick.color: EEEEEE
# Okabe-Ito with white instead of black
axes.prop_cycle: cycler('color', ['56B4E9', 'E69F00', '009E73', 'CC79A7', 'D55E00', '0072B2', 'F0E442', 'FFFFFF'])
image.cmap: magma
